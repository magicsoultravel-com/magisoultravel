<?php
// inc/timezone_banner.php

// Set the default timezone for your server (important for consistent time handling).
// For production, it's best to set this in php.ini.
// This line acts as a fallback if not set globally.
if (!ini_get('date.timezone')) {
    date_default_timezone_set('Europe/Warsaw'); // Example: Set to your server's location
}

/**
 * Generates a Unicode flag emoji from a two-letter country code.
 * Requires mbstring extension (usually enabled by default).
 *
 * @param string $country_code Two-letter ISO country code (e.g., 'US', 'PL').
 * @return string The flag emoji or empty string if invalid code.
 */
function get_flag_emoji($country_code) {
    if (empty($country_code) || strlen($country_code) !== 2) {
        return '';
    }
    $country_code = strtoupper($country_code); // Ensure uppercase for consistent conversion
    $char1 = mb_chr(0x1F1E6 + (ord($country_code[0]) - ord('A')), 'UTF-8');
    $char2 = mb_chr(0x1F1E6 + (ord($country_code[1]) - ord('A')), 'UTF-8');
    return $char1 . $char2;
}

/**
 * Formats a UTC offset in seconds to a shorter notation (e.g., '+5h', '-3.5h').
 *
 * @param int $offset_seconds The UTC offset in seconds.
 * @return string The formatted offset string.
 */
function format_short_offset($offset_seconds) {
    $offset_hours = $offset_seconds / 3600;

    // Use a small epsilon to handle floating point inaccuracies for exactly 0
    if (abs($offset_hours) < 0.0001) { // Check if close to zero
        return '0h';
    } elseif ($offset_hours == floor($offset_hours)) {
        // Whole hours: e.g., +5h, -4h
        return sprintf('%+dh', $offset_hours);
    } else {
        // Half hours: e.g., +5.5h, -3.5h
        // Use .1f for one decimal place, then ensure decimal separator is a dot
        $formatted = sprintf('%+.1fh', $offset_hours);
        return str_replace(',', '.', $formatted); // Replace comma with dot if locale uses comma
    }
}


// Define the timezones, their IDs, and country codes for flag emojis.
// Ordered approximately from East to West.
$timezones = [
    // Far East / Oceania
    'wellington'  => ['id' => 'Pacific/Auckland', 'country_code' => 'NZ'],
    'sydney'      => ['id' => 'Australia/Sydney', 'country_code' => 'AU'],
    'tokyo'       => ['id' => 'Asia/Tokyo', 'country_code' => 'JP'],
    'shanghai'    => ['id' => 'Asia/Shanghai', 'country_code' => 'CN'],
    'jakarta'     => ['id' => 'Asia/Jakarta', 'country_code' => 'ID'],
    'new delhi'   => ['id' => 'Asia/Kolkata', 'country_code' => 'IN'],

    // Middle East / Africa / Europe (moving West) - NEW CITIES ADDED HERE
    'karachi'     => ['id' => 'Asia/Karachi', 'country_code' => 'PK'],     // UTC+5
    'abu dhabi'   => ['id' => 'Asia/Dubai', 'country_code' => 'AE'],       // UTC+4
    'istanbul'    => ['id' => 'Europe/Istanbul', 'country_code' => 'TR'], // UTC+3
    'cairo'       => ['id' => 'Africa/Cairo', 'country_code' => 'EG'],     // UTC+2
    'warsaw'      => ['id' => 'Europe/Warsaw', 'country_code' => 'PL'],
    'london'      => ['id' => 'Europe/London', 'country_code' => 'GB'],

    // Reference / Global Time
    'utc'         => ['id' => 'UTC', 'country_code' => ''],

    // Americas (moving West)
    'bridgetown'  => ['id' => 'America/Barbados', 'country_code' => 'BB'],
    'new york'    => ['id' => 'America/New_York', 'country_code' => 'US'],
    'los angeles' => ['id' => 'America/Los_Angeles', 'country_code' => 'US'],
    'honolulu'    => ['id' => 'Pacific/Honolulu', 'country_code' => 'US'],
];

// PHP to generate the initial time strings and structure
$timezone_data_for_display = [];
foreach ($timezones as $cityName => $data) {
    $timezoneId = $data['id'];
    $countryCode = $data['country_code'];

    $flagEmoji = get_flag_emoji($countryCode);

    try {
        $tz = new DateTimeZone($timezoneId);
        $dateTime = new DateTime('now', $tz);
        $timeFormatted = $dateTime->format('H:i'); // Only hours and minutes

        $offsetSeconds = $tz->getOffset($dateTime);
        $offsetFormatted = format_short_offset($offsetSeconds); // Shorter offset format

        $timezone_data_for_display[] = [
            'cityName'        => htmlspecialchars(strtolower($cityName)), // All lowercase
            'flagEmoji'       => $flagEmoji,
            'timezoneId'      => $timezoneId, // Keep original ID for JS calculations
            'initialTime'     => htmlspecialchars($timeFormatted), // Separate initial time
            'initialOffset'   => htmlspecialchars($offsetFormatted), // Separate initial offset
        ];

    } catch (Exception $e) {
        // Fallback for invalid timezone IDs
        $timezone_data_for_display[] = [
            'cityName'        => htmlspecialchars(strtolower($cityName)),
            'flagEmoji'       => $flagEmoji, // Still show flag if code is valid
            'timezoneId'      => $timezoneId,
            'initialTime'     => 'n/a', // Lowercase n/a
            'initialOffset'   => 'error', // Lowercase error
        ];
        error_log("Error for timezone $timezoneId: " . $e->getMessage());
    }
}
?>

<style>
    /* No custom font import - reverts to browser default */

