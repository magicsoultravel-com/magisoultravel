    .sliding-timezone-container {
        width: 100%;
        overflow: hidden; /* Hides content outside the visible area for sliding */
        white-space: nowrap; /* Ensures all items stay in one row */
        margin-top: 10px; /* Space from your header text */
        box-sizing: border-box; /* Include padding in width */
        /* --- BACKGROUND & FONT SIZE --- */
        /*background-color: #000;  Black background retained for contrast */
        /*color: #333; /* Standard dark gray text for readability */
        font-size: 0.9em; /* Slightly reduced font size retained */
        padding: 5px 0; /* Vertical padding retained */
    }

    .timezone-track {
        display: inline-block; /* Makes it a single line */
        transform: translateX(0);
        transition: none;
        animation: none;
    }

    .timezone-item-wrapper {
        display: inline-block; /* Each item next to each other */
        padding: 0 10px; /* Space between timezone entries */
        line-height: 1.5em; /* Vertical spacing/height for the row */
        box-sizing: border-box;
        vertical-align: middle;
        /* Reverted to standard font: removed font-family 'Orbitron' */
    }

    .timezone-separator {
        padding: 0 5px; /* Space around the '::' separator */
        color: #999; /* Slightly lighter gray for subtle separation */
        display: inline-block;
        vertical-align: middle;
    }

    /* Style for the offset in parenthesis */
    .tz-offset {
        white-space: nowrap; /* Ensure offset stays together */
    }

    /* Styles for individual elements within an item */
    .tz-flag {
        margin-right: 3px; /* Small space after flag */
    }
</style>

<div class="sliding-timezone-container">
    <div class="timezone-track">
        <?php
        // To create a seamless infinite loop for sliding, duplicate the items.
        $display_loops = 2; // Display the full set of timezones twice
        for ($i = 0; $i < $display_loops; $i++):
            foreach ($timezone_data_for_display as $index => $data):
        ?>
            <span class="timezone-item-wrapper"
                  data-timezone-id="<?= $data['timezoneId'] ?>"
                  data-initial-offset="<?= $data['initialOffset'] ?>">
                <span class="tz-flag"><?= $data['flagEmoji'] ?></span>
                <span class="tz-city-name"><?= $data['cityName'] ?></span>
                <span class="tz-time"><?= $data['initialTime'] ?></span>
                <span class="tz-offset">(<?= $data['initialOffset'] ?>)</span>
            </span>
            <?php
            // Add separator unless it's the very last item of the very last loop
            if ($index < count($timezone_data_for_display) - 1 || $i < $display_loops - 1):
            ?>
                <span class="timezone-separator">::</span>
            <?php endif; ?>
        <?php
            endforeach;
        endfor;
        ?>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const timezoneTrack = document.querySelector('.timezone-track');
    const timezoneItems = document.querySelectorAll('.timezone-item-wrapper');
    const separatorElements = document.querySelectorAll('.timezone-separator');

    if (!timezoneTrack || timezoneItems.length === 0) {
        console.warn("Timezone banner elements not found.");
        return;
    }

    let totalOriginalSetWidth = 0;
    const originalItemsCount = <?php echo count($timezone_data_for_display); ?>;

    for (let i = 0; i < originalItemsCount; i++) {
        totalOriginalSetWidth += timezoneItems[i].offsetWidth;
        if (i < originalItemsCount - 1) {
            if (separatorElements[i]) {
                totalOriginalSetWidth += separatorElements[i].offsetWidth;
            }
        }
    }

    let currentPosition = 0;
    const scrollSpeed = 0.2; // Pixels per frame. Adjust for slower/faster sliding.
    let animationFrameId;

    function slideBanner() {
        currentPosition -= scrollSpeed;

        if (Math.abs(currentPosition) >= totalOriginalSetWidth) {
            currentPosition = 0;
        }

        timezoneTrack.style.transform = `translateX(${currentPosition}px)`;
        animationFrameId = requestAnimationFrame(slideBanner);
    }

    // Function to update the time part of each timezone dynamically
    function updateTimes() {
        const now = new Date(); // Get current date/time on the client

        timezoneItems.forEach(item => {
            const timezoneId = item.dataset.timezoneId;
            const timeSpan = item.querySelector('.tz-time');

            if (timeSpan) {
                try {
                    // Use Intl.DateTimeFormat for accurate time display across timezones in JavaScript
                    const options = {
                        hour: '2-digit', minute: '2-digit', // Only hours and minutes now
                        hour12: false, // Force 24-hour format (e.g., 14:30)
                        timeZone: timezoneId // Apply the specific timezone
                    };
                    const timeString = new Intl.DateTimeFormat('en-GB', options).format(now);
                    timeSpan.textContent = timeString; // Update only the time part
                } catch (error) {
                    console.error(`Error updating time for ${timezoneId}:`, error);
                    timeSpan.textContent = 'n/a'; // Lowercase error message
                }
            }
        });
    }

    // Start the sliding animation
    slideBanner();

    // Update the clock display every second
    setInterval(updateTimes, 1000); // Update every 1 second
});
</script>